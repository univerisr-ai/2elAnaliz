{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/latest-summary.json",
      "destination": "/api/[...path].js"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/[...path].js"
    },
    {
      "source": "/marketplace",
      "destination": "/index.html"
    },
    {
      "source": "/marketplace/cpu",
      "destination": "/index.html"
    },
    {
      "source": "/sat",
      "destination": "/index.html"
    },
    {
      "source": "/ilan-ekle",
      "destination": "/index.html"
    },
    {
      "source": "/ilan-ekle/link",
      "destination": "/index.html"
    },
    {
      "source": "/ilan-ekle/manuel",
      "destination": "/index.html"
    },
    {
      "source": "/giris",
      "destination": "/index.html"
    },
    {
      "source": "/kayit",
      "destination": "/index.html"
    },
    {
      "source": "/hakkimizda",
      "destination": "/index.html"
    },
    {
      "source": "/model/:slug",
      "destination": "/index.html"
    },
    {
      "source": "/ilan/:id",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/**/*.js": {
      "includeFiles": "apps/api/dist/data/**",
      "maxDuration": 30
    }
  }
}
