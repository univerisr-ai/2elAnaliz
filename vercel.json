{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/[...path].js"
    }
  ],
  "functions": {
    "api/**/*.js": {
      "includeFiles": "apps/api/dist/data/**",
      "maxDuration": 30
    }
  }
}
