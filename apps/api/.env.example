# ══════════════════════════════════════
# GPU Pusula — Backend Environment Variables
# ══════════════════════════════════════

# Data Source
DATA_SOURCE=github_artifact
GITHUB_PAT_TOKEN=
ANALYZER_REPO_OWNER=your-private-org
ANALYZER_REPO_NAME=your-private-analyzer-repo
ANALYZER_WORKFLOW_ID=analyzer-workflow.yml
ANALYZER_SUMMARY_ARTIFACT_PREFIX=dashboard-summary-

# Opsiyonel: local file fallback
ANALYZER_SUMMARY_FILE=

# Opsiyonel: manuel sync endpoint korumasi
ADMIN_API_KEY=

# Opsiyonel: link/scraper kuyrugu tetikleme
SCRAPER_DISPATCH_TOKEN=
SCRAPER_REPO_OWNER=your-private-org
SCRAPER_REPO_NAME=your-private-scraper-repo
SCRAPER_WORKFLOW_ID=scraper-workflow.yml
SCRAPER_WORKFLOW_REF=main

# Supabase submission/auth sistemi
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=listing-images
SUBMISSIONS_ENABLED=true
USER_SUBMISSION_HOURLY_LIMIT=12
IP_SUBMISSION_HOURLY_LIMIT=32
USER_COMMENT_HOURLY_LIMIT=60
IP_COMMENT_HOURLY_LIMIT=120
MAX_UPLOAD_IMAGES=8
MAX_UPLOAD_IMAGE_MB=8
ALLOWED_INGEST_HOSTS=sahibinden.com,shbdn.com,letgo.com

# Opsiyonel: legacy Telegram bilgileriniz
TELEGRAM_BOT_TOKEN=
TELEGRAM_USER_ID=

# Server
PORT=3001
CORS_ORIGIN=https://gpupusula.shop,http://localhost:5173

# Sync Schedule
SYNC_ON_BOOT=false
SYNC_CRON=0 */6 * * *
