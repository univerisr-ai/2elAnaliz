{
  "name": "gpupusula-api",
  "version": "1.0.0",
  "description": "GPU Pusula — GPU Marketplace Backend API",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "postbuild": "node -e \"const fs=require('fs'); if (fs.existsSync('src/data')) { fs.rmSync('dist/data',{recursive:true,force:true}); fs.cpSync('src/data','dist/data',{recursive:true}); }\"",
    "start": "node dist/index.js",
    "sync": "tsx src/jobs/run-sync.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.103.3",
    "adm-zip": "^0.5.17",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "multer": "^2.1.1",
    "node-cron": "^3.0.3"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.2",
    "@types/multer": "^2.1.0",
    "@types/node": "^22.15.2",
    "@types/node-cron": "^3.0.11",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
